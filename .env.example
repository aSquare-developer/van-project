APP_NAME="Van Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Europe/Tallinn
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=van_project
DB_USERNAME=van_project
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# Trusted HTTPS analysis endpoint (full URL), configured only on the server.
VISION_PROVIDER=custom
VISION_ENDPOINT=
VISION_TOKEN=
VISION_SILICONE_MODEL_VERSION=

# Direct OpenAI adapter: set VISION_PROVIDER=openai and a vision/structured-output model snapshot.
OPENAI_API_KEY=
VISION_OPENAI_MODEL=
# Keep false until acceptance against labelled real photos. Applies to NEW attempts only.
VISION_OPENAI_AUTOMATIC_DECISIONS=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
